# Export these variables in your shell/process manager. Django does not read
# this file automatically. Never commit real .env files or credentials.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Without DATABASE_URL, local development uses backend/db.sqlite3.
DATABASE_URL=

# Select a model snapshot supporting Responses API structured outputs.
# Empty values leave the AI portfolio inactive; baseline paper trading works.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_ATTEMPT_LIMIT=600
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/
# Optional; requires a CoinGlass plan with the Model1 heatmap endpoint.
COINGLASS_API_KEY=

# Explicitly opt in only after reviewing evidence and the dedicated account.
LIVE_TRADING_ENABLED=false
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_OWNER_ID=
LIVE_ACCOUNT_DEDICATED=false
LIVE_WITHDRAWALS_DISABLED_CONFIRMED=false
LIVE_MAX_CAPITAL=0
